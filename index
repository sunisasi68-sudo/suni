<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>สงกรานต์ จากดวงดาวสู่สายน้ำ</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;600;700&display=swap">
<style>
:root{--bg:#0f1426;--ink:#f6ecd2;--gold:#e8b04a;--red:#c8452d;--jade:#3f8f7a;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--ink);font-family:'Noto Sans Thai',system-ui,sans-serif}
body{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:12px}
#wrap{width:min(100%,960px)}
#screen{position:relative;aspect-ratio:16/9;background:#000;border-radius:10px;overflow:hidden}
#stage{width:100%;height:100%;display:block}
#stage.paused *{animation-play-state:paused!important}
#era{position:absolute;top:10px;left:10px;background:rgba(15,20,38,.72);padding:4px 12px;border-radius:99px;font-size:clamp(11px,1.8vw,15px);font-weight:600;color:var(--gold)}
#sub{position:absolute;left:0;right:0;bottom:0;padding:clamp(8px,2vw,18px) clamp(10px,3vw,28px);background:linear-gradient(transparent,rgba(8,10,20,.88) 35%);font-size:clamp(12px,2.1vw,19px);line-height:1.7;text-align:center}
#cover{position:absolute;inset:0;display:flex;flex-direction:column;gap:14px;align-items:center;justify-content:center;background:rgba(10,14,30,.82);text-align:center;padding:16px}
#cover h1{margin:0;font-size:clamp(22px,5vw,46px);color:var(--gold);line-height:1.3}
#cover p{margin:0;font-size:clamp(12px,2vw,17px);opacity:.85}
button{font:inherit;cursor:pointer;border:0;border-radius:99px;background:var(--gold);color:#201505;font-weight:700;padding:10px 26px}
button:focus-visible{outline:3px solid #fff;outline-offset:2px}
#bar{display:flex;gap:3px;margin-top:10px}
#bar button{flex:1;height:10px;padding:0;border-radius:3px;background:#2a3358;position:relative;overflow:hidden}
#bar button i{position:absolute;inset:0;width:0;background:var(--gold)}
#ctl{display:flex;gap:10px;align-items:center;margin-top:10px;font-size:14px;flex-wrap:wrap}
#ctl button{padding:6px 16px;background:#2a3358;color:var(--ink);font-weight:600}
#time{margin-left:auto;opacity:.8;font-variant-numeric:tabular-nums}
.t{animation:fade 1.2s both}
@keyframes bob{50%{transform:translateY(-1.2px)}}
@keyframes arm{from{transform:rotate(25deg)}to{transform:rotate(-70deg)}}
@keyframes arm2{from{transform:rotate(-25deg)}to{transform:rotate(60deg)}}
@keyframes run{from{transform:translateX(-24px)}to{transform:translateX(184px)}}
@keyframes sp{from{transform:translateY(0) scale(1);opacity:1}to{transform:translateY(-7px) scale(.4);opacity:0}}
@keyframes cam0{from{transform:scale(1)}to{transform:scale(1.12)}}
@keyframes cam1{from{transform:translateX(-3px) scale(1.08)}to{transform:translateX(3px) scale(1.08)}}
@keyframes cam2{from{transform:scale(1.12)}to{transform:scale(1)}}
@keyframes fade{from{opacity:0}to{opacity:1}}
@keyframes rise{from{transform:translateY(22px)}to{transform:translateY(0)}}
@keyframes jet{to{stroke-dashoffset:-1}}
@keyframes sway{50%{transform:translateY(-2px)}}
@keyframes tw{50%{opacity:.25}}
@keyframes sunarc{0%{transform:translate(-52px,12px)}50%{transform:translate(0,-6px)}100%{transform:translate(52px,12px)}}
@keyframes boat{from{transform:translateX(-30px)}to{transform:translateX(150px)}}
@keyframes bird{from{transform:translate(0,0);opacity:1}to{transform:translate(46px,-40px);opacity:0}}
@keyframes flip{0%,38%{opacity:1}42%,100%{opacity:0}}
@keyframes flip2{0%,40%{opacity:0}44%,100%{opacity:1}}
@keyframes burst{from{transform:scale(.1);opacity:1}to{transform:scale(1);opacity:0}}
@keyframes drift{from{transform:translateX(-24px)}to{transform:translateX(24px)}}
@keyframes lit{from{opacity:.9}to{opacity:0}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes conf{from{transform:translateY(8px);opacity:1}to{transform:translateY(-70px);opacity:0}}
@keyframes sepia{from{opacity:.5}to{opacity:0}}
.jet{fill:none;stroke:#8fd8f0;stroke-width:.9;stroke-linecap:round;stroke-dasharray:.3 .7;animation:jet 1.1s linear infinite}
</style>
</head>
<body>
<div id="wrap">
  <div id="screen">
    <svg id="stage" viewBox="0 0 160 90" preserveAspectRatio="xMidYMid slice" role="img" aria-label="แอนิเมชันประวัติสงกรานต์"></svg>
    <div id="era"></div>
    <div id="sub"></div>
    <div id="cover">
      <h1>สงกรานต์ จากดวงดาวสู่สายน้ำ</h1>
      <p>ประวัติวันสงกรานต์ ตั้งแต่ต้นกำเนิดจนถึงปัจจุบัน (พฤศจิกายน 2569) · ความยาว 3 นาที</p>
      <button id="go">เล่นคลิป</button>
      <p>เปิดเสียงเพื่อฟังบรรยายภาษาไทย (ใช้เสียงอ่านของเบราว์เซอร์ หากไม่มีเสียงจะแสดงคำบรรยายแทน)</p>
    </div>
  </div>
  <div id="bar" role="group" aria-label="เลือกฉาก"></div>
  <div id="ctl">
    <button id="pp">หยุด</button>
    <button id="snd">เสียง: เปิด</button>
    <span id="time">0:00 / 3:00</span>
  </div>
</div>
<script>
const sky=(id,a,b)=>`<defs><linearGradient id="${id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${a}"/><stop offset="1" stop-color="${b}"/></linearGradient></defs><rect width="160" height="90" fill="url(#${id})"/>`;
const P=(x,y,c,s=1,k='#f1c9a0')=>{const d=(x*7%10)/10,a='transform-box:fill-box;transform-origin:50% 0;';return `<g transform="translate(${x} ${y}) scale(${s})"><g style="animation:bob ${.7+d*.4}s ${d}s ease-in-out infinite"><circle cy="-9" r="2.6" fill="${k}"/><path d="M-3-6h6l1.5 9h-9z" fill="${c}"/><rect x="-5" y="-6" width="2" height="6" rx="1" fill="${c}" style="${a}animation:arm ${.8+d*.3}s ${d}s ease-in-out infinite alternate"/><rect x="3" y="-6" width="2" height="6" rx="1" fill="${c}" style="${a}animation:arm2 ${.8+d*.3}s ${d}s ease-in-out infinite alternate"/></g><rect x="-2.5" y="3" width="2" height="5" fill="#2b2b3a"/><rect x=".5" y="3" width="2" height="5" fill="#2b2b3a"/></g>`};
const Sp=(x,y,d=0)=>[0,1,2].map(i=>`<circle cx="${x+i*3-3}" cy="${y}" r=".9" fill="#bfeaff" style="animation:sp .9s ${d+i*.15}s infinite"/>`).join('');
const J=(x,y,dx,h,d=0)=>`<path class="jet" pathLength="1" style="animation-delay:${d}s" d="M${x} ${y}q${dx/2} ${-h} ${dx} 4"/>`;
const hill=(y,c)=>`<path d="M0 ${y}q40-14 80 0t80 0V90H0z" fill="${c}"/>`;
const tree=(x,y)=>`<rect x="${x-1}" y="${y}" width="2" height="12" fill="#5a3b22"/>`+[[0,-2,5],[-4,1,4],[4,1,4],[0,3,4]].map(a=>`<circle cx="${x+a[0]}" cy="${y+a[1]}" r="${a[2]}" fill="#f2c230"/>`).join('');
const house=(x,y,c='#8a5a33')=>`<rect x="${x}" y="${y}" width="18" height="9" fill="${c}"/><path d="M${x-2} ${y}l11-8 11 8z" fill="#6b3f22"/><rect x="${x+2}" y="${y+9}" width="1.5" height="6" fill="#4a2d18"/><rect x="${x+14}" y="${y+9}" width="1.5" height="6" fill="#4a2d18"/>`;
const chedi=(x,y,s=1,c='#e8b04a')=>`<g transform="translate(${x} ${y}) scale(${s})"><path d="M-10 0h20v-3h-17v-4h14v-4h-11v-5h8v-6l-3-3 3-3-3 3-3-3 3 3-3 3v6h8v5h-11v4h14v3h-17z" fill="${c}"/></g>`;
const stars=n=>Array.from({length:n},(_,i)=>`<circle cx="${(i*37)%160}" cy="${(i*23)%55+2}" r=".5" fill="#fff" style="animation:tw ${2+i%3}s ${i%5*.4}s infinite"/>`).join('');

const S=[
{t:12,era:'บทนำ',txt:'ทุกเดือนเมษายน ผืนแผ่นดินไทยจะเต็มไปด้วยเสียงหัวเราะและสายน้ำ แต่เทศกาลที่เรารู้จักดีนี้ เริ่มต้นมาจากไหน?',
 svg:()=>sky('a','#f6a85a','#fbe3ae')+`<circle cx="80" cy="62" r="13" fill="#fff3c2" style="animation:rise 8s both"/>`+hill(66,'#3f8f7a')+tree(22,50)+tree(138,48)+house(104,62)+house(34,64)+`<rect y="76" width="160" height="14" fill="#2f6f5e"/>`+P(66,80,'#c8452d')+P(94,80,'#2a6fb0')+J(70,70,14,10)+J(90,70,-14,10,.4)+Sp(84,74)+Sp(76,74,.4)+`<text class="t" x="80" y="24" text-anchor="middle" font-size="9" font-weight="700" fill="#7a2a14" style="animation-delay:.6s">สงกรานต์</text>`},
{t:18,era:'ต้นกำเนิด · ตามคติโบราณ',txt:'คำว่า "สงกรานต์" มาจากภาษาสันสกฤต แปลว่า การเคลื่อนย้าย หมายถึงวันที่ดวงอาทิตย์ย้ายจากราศีมีนเข้าสู่ราศีเมษ นับเป็นการขึ้นปีใหม่ตามคติโบราณ ซึ่งแผ่ขยายมายังเอเชียตะวันออกเฉียงใต้',
 svg:()=>sky('b','#0e1630','#2c4078')+stars(40)+`<g stroke="#9fb4ff" stroke-width=".4" fill="#cfe0ff"><path fill="none" d="M20 40l10-6 10 4 8-8M30 34l-2 12"/>${[[20,40],[30,34],[40,38],[48,30],[28,46]].map(p=>`<circle cx="${p[0]}" cy="${p[1]}" r="1.2"/>`).join('')}<path fill="none" d="M112 34l10-4 8 6 8-2"/>${[[112,34],[122,30],[130,36],[138,34]].map(p=>`<circle cx="${p[0]}" cy="${p[1]}" r="1.2"/>`).join('')}</g><text x="34" y="58" font-size="5" fill="#cfe0ff" text-anchor="middle">ราศีมีน</text><text x="126" y="50" font-size="5" fill="#cfe0ff" text-anchor="middle">ราศีเมษ</text><g style="animation:sunarc 14s linear both"><circle cx="80" cy="34" r="7" fill="#e8b04a"/><circle cx="80" cy="34" r="10" fill="none" stroke="#e8b04a" stroke-opacity=".4"/></g>`+hill(76,'#1a2447')+P(80,82,'#b5651d',1.2)},
{t:20,era:'สุโขทัย · ผสานกับวิถีสยาม',txt:'เมื่อมาถึงแผ่นดินสยาม ความเชื่อเดิมผสานกับพุทธศาสนาและวิถีเกษตร ช่วงกลางเมษายนคือปลายหน้าแล้ง ผู้คนจึงทำบุญ สรงน้ำพระ ปล่อยนกปล่อยปลา และใช้น้ำเป็นสัญลักษณ์ของการชำระล้างสิ่งไม่ดี',
 svg:()=>sky('c','#9fd4f0','#fbeed0')+`<rect y="70" width="160" height="20" fill="#d9bf86"/>`+chedi(80,66,1.4)+`<g><rect x="22" y="52" width="14" height="16" fill="#e8b04a"/><circle cx="29" cy="48" r="4" fill="#f4d27a"/></g>`+P(46,76,'#c8452d')+J(48,66,-14,8)+P(14,76,'#3f8f7a')+J(16,66,10,8,.5)+`<path d="M120 76l6-12 6 12z" fill="#e6cf98"/><path d="M130 76l5-10 5 10z" fill="#e6cf98"/><path d="M126 64v-5" stroke="#c8452d"/>`+P(110,78,'#2a6fb0')+[0,1,2].map(i=>`<path d="M${100+i*6} 40l3 2 3-2" stroke="#444" fill="none" style="animation:bird 6s ${i*.8}s infinite"/>`).join('')},
{t:20,era:'อยุธยา',txt:'ในสมัยอยุธยา สงกรานต์เป็นประเพณีขึ้นปีใหม่ที่ทั้งราชสำนักและราษฎรถือปฏิบัติ มีพิธีหลวงและพิธีของชาวบ้าน แม้แต่นักเดินทางต่างชาติก็ยังบันทึกถึงเทศกาลนี้ไว้',
 svg:()=>sky('d','#c8452d','#f6b567')+`<circle cx="110" cy="48" r="12" fill="#ffe9a8"/>`+`<path d="M20 70v-20l5-8 5 8v20zM44 70v-34l7-14 7 14v34zM70 70v-14l4-6 4 6v14z" fill="#3a1f2e"/><path d="M51 22v-6" stroke="#3a1f2e" stroke-width="1.4"/>`+`<rect y="70" width="160" height="20" fill="#1f3a5c"/><g style="animation:boat 20s linear both"><path d="M0 74h28l-4 6h-20z" fill="#7a2a14"/><path d="M6 74v-10h16v10z" fill="#e8b04a"/><path d="M4 64h20l-10-6z" fill="#c8452d"/>${P(8,73,'#f6ecd2',.6)}${P(20,73,'#f6ecd2',.6)}</g><path d="M0 84h160" stroke="#8fb4d8" stroke-opacity=".4" stroke-dasharray="6 5"/>`},
{t:20,era:'รัตนโกสินทร์',txt:'เข้าสู่ยุครัตนโกสินทร์ สงกรานต์ยังคงเป็นวันปีใหม่ของไทย การรดน้ำขอพรผู้ใหญ่กลายเป็นภาพคุ้นตาที่สะท้อนความกตัญญู ขณะที่ทางราชการเองก็ถือเดือนเมษายนเป็นต้นปีด้วย',
 svg:()=>sky('e','#f3d9a0','#f9ecc8')+house(100,56,'#a06a3a')+`<rect y="72" width="160" height="18" fill="#c9a86a"/>`+tree(20,52)+P(60,78,'#6b4a8a',1.3,'#e8c39c')+P(76,78,'#c8452d')+`<path d="M78 70q4-3 6 0" stroke="#8fd8f0" fill="none" stroke-width="1"/>`+J(80,64,-10,6)+`<ellipse cx="68" cy="82" rx="10" ry="2" fill="#6b4a8a" opacity=".3"/><rect width="160" height="90" fill="#8a6a2a" style="animation:sepia 16s forwards"/>`},
{t:18,era:'พ.ศ. 2484',txt:'ปี พ.ศ. 2484 ประเทศไทยย้ายวันขึ้นปีใหม่ตามสากลมาเป็น 1 มกราคม แต่หัวใจของคนไทยไม่ได้ย้ายตาม สงกรานต์ยังเป็นเทศกาลที่ครอบครัวกลับบ้านมาพบกันเสมอ',
 svg:()=>sky('f','#1b2a4a','#3d5a8a')+stars(18)+`<rect x="56" y="14" width="48" height="36" rx="3" fill="#f6ecd2"/><rect x="56" y="14" width="48" height="9" fill="#c8452d"/><text x="80" y="38" text-anchor="middle" font-size="9" font-weight="700" fill="#2b2b3a" style="animation:flip 8s both">เมษายน</text><text x="80" y="38" text-anchor="middle" font-size="9" font-weight="700" fill="#2b2b3a" style="animation:flip2 8s both">1 ม.ค.</text>`+[[24,30,'#e8b04a'],[134,26,'#c8452d'],[120,52,'#7fd1b9']].map((f,i)=>`<g transform="translate(${f[0]} ${f[1]})" style="animation:burst 2.4s ${3+i*.7}s infinite both;transform-box:fill-box"><circle r="9" fill="none" stroke="${f[2]}" stroke-width="1.5" stroke-dasharray="1.2 2.2"/></g>`).join('')+hill(72,'#1a2f2c')+chedi(26,76,1,'#c9a04a')+P(70,82,'#e8b04a')+P(84,82,'#c8452d')+P(94,82,'#3f8f7a',.7)},
{t:20,era:'ปัจจุบัน · เทศกาลร่วมสมัย',txt:'วันนี้ วันที่ 13 เมษายนคือวันผู้สูงอายุแห่งชาติ วันที่ 14 คือวันครอบครัว สงกรานต์จึงเป็นทั้งวันแห่งความสนุกและวันแห่งความผูกพัน ตั้งแต่เชียงใหม่ถึงถนนสีลม ผู้คนทั่วโลกต่างมาร่วมเล่นน้ำด้วยกัน',
 svg:()=>sky('g','#6cc4ee','#d8f1fb')+`<rect x="0" y="22" width="26" height="50" fill="#e8647a"/><rect x="28" y="34" width="22" height="38" fill="#f2b84a"/><rect x="112" y="26" width="24" height="46" fill="#7a63c8"/><rect x="138" y="38" width="22" height="34" fill="#3f8f7a"/><rect y="72" width="160" height="18" fill="#4a4f66"/><rect x="38" y="8" width="84" height="12" rx="2" fill="#c8452d"/><text x="80" y="16.5" text-anchor="middle" font-size="5.2" font-weight="700" fill="#fff3d0">13 วันผู้สูงอายุ · 14 วันครอบครัว</text>`+P(52,84,'#f2569a')+P(66,84,'#ffb02e')+P(96,84,'#2a9d8f')+P(110,84,'#e76f51')+J(56,76,16,12)+J(100,76,-18,12,.3)+J(70,76,12,14,.6)+J(114,76,-14,10,.9)+`<g style="animation:drift 8s ease-in-out infinite alternate">${P(80,85,'#6b4a8a',1.1,'#e8c39c')}</g>`+Sp(72,80)+Sp(82,80,.3)+`<g style="animation:run 7s linear infinite">${P(0,86,'#ff5a5f')}${P(-12,86,'#2ec4b6',.9)}</g><g style="animation:run 10s 2s linear infinite">${P(0,87,'#ffb02e',.9)}${P(-11,87,'#8a63d2')}</g><circle cx="136" cy="14" r="4" fill="#ffe27a"/>`},
{t:17,era:'พ.ศ. 2563–2564',txt:'ในปี พ.ศ. 2563 และ 2564 โรคระบาดทำให้งานรื่นเริงต้องหยุดลง แต่ผู้คนยังหาทางส่งความห่วงใยถึงกัน และสงกรานต์ก็ฟื้นกลับมาอีกครั้ง',
 svg:()=>sky('h','#101a30','#2a3558')+`<rect y="70" width="160" height="20" fill="#1b2238"/><rect x="20" y="30" width="30" height="40" fill="#222c4a"/><rect x="110" y="24" width="30" height="46" fill="#222c4a"/><rect x="62" y="22" width="36" height="26" rx="2" fill="#16203a" stroke="#6fb3ff" stroke-width=".6"/><rect x="65" y="25" width="14" height="20" fill="#2d4a7a"/><rect x="81" y="25" width="14" height="20" fill="#2d4a7a"/><circle cx="72" cy="33" r="3" fill="#e8c39c"/><circle cx="88" cy="33" r="3" fill="#e8c39c"/><path d="M68 44q4-7 8 0M84 44q4-7 8 0" fill="#c8452d"/>`+`<rect x="30" y="18" width="1.4" height="52" fill="#555"/><circle cx="30.7" cy="18" r="3" fill="#ffd77a"/><rect width="160" height="90" fill="#101a30" style="animation:lit 14s .5s forwards" opacity=".9"/>`+`<path d="M0 74h160" stroke="#ffd77a" stroke-opacity=".25"/>`},
{t:17,era:'ธันวาคม 2566',txt:'เดือนธันวาคม พ.ศ. 2566 องค์การยูเนสโกขึ้นทะเบียน "สงกรานต์ในประเทศไทย" เป็นมรดกภูมิปัญญาทางวัฒนธรรมที่จับต้องไม่ได้ของมนุษยชาติ',
 svg:()=>sky('i','#12254a','#2e5a9a')+stars(30)+`<g transform="translate(80 40)"><circle r="22" fill="#2a74c8"/><g fill="none" stroke="#9fd0ff" stroke-width=".5"><ellipse rx="22" ry="8"/><ellipse rx="9" ry="22"/><path d="M-22 0h44"/></g><path d="M-8-12q8 6 2 14t6 10" fill="none" stroke="#7fd1b9" stroke-width="3"/><g style="animation:spin 12s linear infinite"><circle cx="30" cy="0" r="2" fill="#e8b04a"/><circle cx="-30" cy="0" r="2" fill="#e8b04a"/></g></g><path d="M52 66q-14-8-12-26M108 66q14-8 12-26" fill="none" stroke="#e8b04a" stroke-width="2" stroke-dasharray="3 2"/><text x="80" y="76" text-anchor="middle" font-size="8" font-weight="700" fill="#f6ecd2">UNESCO</text><text x="80" y="84" text-anchor="middle" font-size="4.6" fill="#e8b04a">สงกรานต์ในประเทศไทย</text>`},
{t:18,era:'พ.ศ. 2569 · พฤศจิกายน 2569',txt:'สงกรานต์ปี พ.ศ. 2569 จัดยิ่งใหญ่ระดับโลก มีนางสงกรานต์ชื่อ “นางรากษสเทวี” และมีผู้ร่วมงานนับล้านทั่วประเทศ ขณะนี้พฤศจิกายน 2569 แล้ว อีกไม่กี่เดือนสายน้ำแห่งความสุขจะกลับมาอีกครั้ง สงกรานต์จึงไม่ใช่แค่เทศกาล แต่คือความทรงจำที่ส่งต่อกันมาหลายร้อยปี',
 svg:()=>sky('j','#f58f6b','#fbd8a0')+`<rect y="72" width="160" height="18" fill="#4a4f66"/><g style="animation:drift 14s ease-in-out infinite alternate"><rect x="52" y="56" width="56" height="12" rx="2" fill="#c8452d"/><rect x="52" y="66" width="56" height="3" fill="#e8b04a"/><circle cx="62" cy="71" r="3" fill="#222"/><circle cx="98" cy="71" r="3" fill="#222"/><path d="M80 52l-5-6 5-6 5 6z" fill="#e8b04a"/><circle cx="80" cy="36" r="4" fill="#f1c9a0"/><path d="M76 33l4-7 4 7z" fill="#e8b04a"/><path d="M73 56q7-14 14 0z" fill="#7a63c8"/></g>`+[[20,60],[34,66],[126,62],[142,66],[100,50],[60,48]].map((p,i)=>`<circle cx="${p[0]}" cy="${p[1]}" r="1.4" fill="${['#f2569a','#ffd13a','#2a9d8f'][i%3]}" style="animation:conf ${3+i%3}s ${i*.4}s infinite"/>`).join('')+P(24,84,'#2a6fb0')+P(136,84,'#f2569a')+J(28,76,14,10)+J(132,76,-14,10,.4)+`<text x="80" y="14" text-anchor="middle" font-size="8" font-weight="700" fill="#7a2a14">สงกรานต์ 2569</text><g style="animation:fade 2s 12s both;opacity:0"><rect width="160" height="90" fill="#0f1426" opacity=".72"/><text x="80" y="42" text-anchor="middle" font-size="9" font-weight="700" fill="#e8b04a">สงกรานต์ สุขสันต์ทุกปี</text><text x="80" y="54" text-anchor="middle" font-size="4.6" fill="#f6ecd2">พฤศจิกายน 2569</text></g>`}
];

const $=id=>document.getElementById(id);
const stage=$('stage'),sub=$('sub'),era=$('era'),bar=$('bar');
let cur=0,el=0,playing=false,last=0,sound=true,started=false;
const total=S.reduce((a,s)=>a+s.t,0);
S.forEach((s,i)=>{const b=document.createElement('button');b.innerHTML='<i></i>';b.title='ฉาก '+(i+1)+' · '+s.era;b.setAttribute('aria-label','ไปฉาก '+(i+1));b.onclick=()=>{go(i);if(!playing)toggle(true)};bar.appendChild(b)});
const fmt=s=>Math.floor(s/60)+':'+String(Math.floor(s%60)).padStart(2,'0');
function speak(){try{speechSynthesis.cancel();if(!sound||!playing)return;const u=new SpeechSynthesisUtterance(S[cur].txt.replace(/["“”]/g,''));u.lang='th-TH';u.rate=.95;speechSynthesis.speak(u)}catch(e){}}
const CL=[0,2,4,6,9];
function draw(i){const cl=CL.includes(i)?[10,70,120].map((x,k)=>`<g style="animation:drift ${18+k*5}s linear infinite alternate"><ellipse cx="${x}" cy="${12+k*6}" rx="12" ry="3.5" fill="#fff" opacity=".7"/><ellipse cx="${x+7}" cy="${10+k*6}" rx="8" ry="3" fill="#fff" opacity=".7"/></g>`).join(''):'';stage.innerHTML=`<g style="transform-origin:80px 45px;animation:cam${i%3} ${S[i].t+1}s ease-in-out both">`+S[i].svg().replace(/(<rect width="160" height="90" fill="url\(#\w+\)"\/>)/,'$1'+cl)+`</g><rect width="160" height="90" fill="#000" style="animation:lit .9s forwards"/>`}
let ac,mt,mi=0;const NT=[262,294,330,392,440,524,440,392];
function music(on){try{if(!ac){ac=new (window.AudioContext||window.webkitAudioContext)();mt=setInterval(()=>{if(ac.state!=='running'||!sound)return;const o=ac.createOscillator(),g=ac.createGain();o.type='triangle';o.frequency.value=NT[mi++%8]*(mi%16<8?1:.75);g.gain.setValueAtTime(.05,ac.currentTime);g.gain.exponentialRampToValueAtTime(.001,ac.currentTime+.6);o.connect(g).connect(ac.destination);o.start();o.stop(ac.currentTime+.6)},450)}on?ac.resume():ac.suspend()}catch(e){}}
function go(i){cur=i;el=0;draw(i);sub.textContent=S[i].txt;era.textContent=S[i].era;speak();ui()}
function ui(){const done=S.slice(0,cur).reduce((a,s)=>a+s.t,0)+el;[...bar.children].forEach((b,i)=>{b.firstChild.style.width=(i<cur?100:i==cur?Math.min(100,el/S[i].t*100):0)+'%'});$('time').textContent=fmt(done)+' / '+fmt(total)}
function toggle(on){playing=on;music(on);stage.classList.toggle('paused',!on);$('pp').textContent=on?'หยุด':'เล่นต่อ';try{if(on){speechSynthesis.paused?speechSynthesis.resume():speak()}else speechSynthesis.pause()}catch(e){}}
function tick(ts){if(playing){el+=(ts-last)/1000;if(el>=S[cur].t){if(cur+1<S.length)go(cur+1);else{playing=false;music(false);stage.classList.add('paused');$('pp').textContent='เล่นอีกครั้ง';el=S[cur].t}}ui()}last=ts;requestAnimationFrame(tick)}
$('go').onclick=()=>{$('cover').style.display='none';started=true;playing=true;music(true);go(0)};
$('pp').onclick=()=>{if(!started)return $('go').click();if(el>=S[cur].t&&cur==S.length-1){go(0);toggle(true)}else toggle(!playing)};
$('snd').onclick=()=>{sound=!sound;$('snd').textContent='เสียง: '+(sound?'เปิด':'ปิด');if(sound)speak();else try{speechSynthesis.cancel()}catch(e){}};
draw(0);sub.textContent=S[0].txt;era.textContent=S[0].era;stage.classList.add('paused');ui();
requestAnimationFrame(t=>{last=t;tick(t)});
</script>
